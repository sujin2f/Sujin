{
    "name": "common-share",
    "version": "1.0.0",
    "description": "sharable utility modules across all types of Javascript",
    "author": "Sujin Choi",
    "license": "ISC",
    "scripts": {
        "build": "rimraf dist && tsc",
        "test": "jest --no-cache --forceExit --coverage --detectOpenHandles",
        "lint": "eslint ./src/**/*.ts"
    },
    "dependencies": {
        "winston": "^3.18.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@types/jest": "^30.0.0",
        "eslint": "^9.39.1",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "rimraf": "^6.1.0",
        "ts-jest": "^29.4.5",
        "tsc": "^2.0.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.3"
    },
    "jest": {
        "clearMocks": true,
        "collectCoverage": true,
        "coverageDirectory": "coverage",
        "coverageProvider": "v8",
        "testEnvironment": "jest-environment-jsdom",
        "testMatch": [
            "<rootDir>/src/**/?(*.)+(spec|test).[tj]s?(x)"
        ],
        "setupFiles": [
            "<rootDir>/.jest/setup.jest.js"
        ],
        "moduleNameMapper": {
            "^@test/(.*)$": "<rootDir>/.jest/$1"
        },
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "preset": "ts-jest",
        "transform": {
            "^.+\\.(ts|tsx)?$": "ts-jest"
        }
    },
    "prettier": {
        "arrowParens": "always",
        "bracketSpacing": true,
        "endOfLine": "lf",
        "printWidth": 120,
        "proseWrap": "preserve",
        "quoteProps": "as-needed",
        "semi": false,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "all",
        "useTabs": false
    }
}
