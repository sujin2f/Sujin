<!DOCTYPE html>
<html lang="en">
    <head>
        <title><%= TITLE %></title>
        <meta name="description" content="<%= DESCRIPTION %>" />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#000000" />
        <base href="/" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="manifest" href="/<%= VERSION %>/manifest.json" />
        <% if (IS_PRODUCTION) { %>
            <link rel="stylesheet" type="text/css" href="/<%= VERSION %>/<%= CSS['main.css'] %>" />
        <% } %>
        <meta property="og:title" content="<%= TITLE %>" />
        <meta property="og:description" content="<%= DESCRIPTION %>" />
        <meta property="og:url" content="<%= URL %>" />
        <meta property="og:image" content="<%= IMAGE %>" />
        <meta property="twitter:card" content="summary" />
        <meta property="twitter:title" content="<%= TITLE %>" />
        <meta property="twitter:description" content="<%= DESCRIPTION %>" />
        <meta property="twitter:image" content="<%= IMAGE %>" />

        <% if (IS_PRODUCTION && GOOGLE_AD_CLIENT) { %>
        <!-- Global site tag (gtag.js) - Google Analytics -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=UA-37266518-1"
        ></script>
        <script>
            window.dataLayer = window.dataLayer || []
            function gtag() {
                dataLayer.push(arguments)
            }
            gtag('js', new Date())
            gtag('config', 'UA-37266518-1')
        </script>
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= GOOGLE_AD_CLIENT %>"
            crossorigin="anonymous"
        ></script>
        <% } %>
        <script>
            var frontendVars = {
                SITE_NAME: '<%= SITE_NAME %>',
                EXCERPT: '<%= EXCERPT %>',
                FRONTEND: '<%= FRONTEND %>',
                FLICKR_ID: '<%= FLICKR_ID %>',
                IS_PRODUCTION: '<%= IS_PRODUCTION %>',
                GOOGLE_AD_CLIENT: '<%= GOOGLE_AD_CLIENT %>',
                GOOGLE_AD_SLOT: '<%= GOOGLE_AD_SLOT %>',
                VERSION: '<%= VERSION %>'
            }
        </script>
    </head>
    <body>
        <noscript>You need to enable JavaScript to run this app.</noscript>
        <div id="root" role="main"></div>
        <script src="/<%= VERSION %>/<%= JS['main.js'] %>"></script>
        <% if (IS_PRODUCTION) { %>
            <script src="/<%= VERSION %>/<%= JS['runtime.js'] %>"></script>
            <script src="/<%= VERSION %>/<%= JS['vendors.js'] %>"></script>
        <% } %>
    </body>
</html>
