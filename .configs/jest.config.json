{
    "preset": "ts-jest",
    "testEnvironment": "jest-environment-jsdom",
    "testMatch": ["<rootDir>/src/common/**/?(*.)+(spec).ts?(x)"],
    "testPathIgnorePatterns": ["<rootDir>/node_modules/"],
    "moduleNameMapper": {
        "\\.(css|scss)$": "<rootDir>/.configs/jest/__mocks__/styleMock.js",
        "\\.svg$": "<rootDir>/.configs/jest/__mocks__/styleMock.js",
        "@common/*": "<rootDir>src/common/$1",
        "@constants/*": "<rootDir>src/constants/$1",
        "@frontend/*": "<rootDir>src/frontend/$1",
        "@server/*": "<rootDir>src/server/$1",
        "@project/types/*": "<rootDir>src/types/$1",
        "@utils/*": "<rootDir>src/utils/$1"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
        "<rootDir>/src/common/**/*.{ts,tsx}",
        "!<rootDir>/src/**/*.spec.{ts,tsx}",
        "!<rootDir>/src/**/*.d.{ts,tsx}",
        "!<rootDir>/src/__tests__/*"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "coverageThreshold": {
        "global": {
            "branches": 80,
            "functions": 80,
            "lines": 80,
            "statements": 80
        }
    },
    "verbose": true,
    "setupFiles": ["<rootDir>/.configs/jest/setup.jest.js"]
}
