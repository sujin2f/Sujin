{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["es2022"],
        "outDir": "./.build",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@common/*": ["../common/*"],
            "@lib/*": ["../lib/*"],
            "@jest/*": ["../.jest/*"],
            "@src/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/resolvers/query/spectra.spec.ts"],
    "exclude": ["node_modules"]
}
