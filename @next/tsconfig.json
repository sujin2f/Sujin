{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@app/*": ["./app/*"],
            "@lib/*": ["./lib/*"],
            "@common/*": ["./common/*"],
            "@jest/*": ["./.jest/*"],
            "@sujin/lib/*": ["../@lib/src/*"],
            "@sujin/share/*": ["../@common/src/*"]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        "@next/next-env.d.ts",
        ".next/types/**/*.ts",
        "app/auth/login/page.tsx.bak",
        "app/auth/login/[...referer]/page.tsx.bak",
        "app/auth/login/[...referer]/Login.client.tsx.bak",
        "app/auth/redirect/[...referer]/page.tsx.bak",
        "app/auth/redirect/page.tsx.bak"
    ],
    "exclude": ["node_modules", "wordpress"]
}
