{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["es2022"],
        "outDir": "./.build",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@jest/*": ["../.jest/*"],
            "@src/*": ["./src/*"],
            "@sujin/lib/*": ["../@lib/src/*"],
            "@sujin/node-cache/*": ["../@common/node-cache/src/*"],
            "@sujin/share/*": ["../@common/share/src/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "src/**/*.spec.ts", "../.jest/*"]
}
