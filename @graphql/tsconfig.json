{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["es2022"],
        "outDir": "./.build",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@test/*": ["./.jest/*"],
            "@src/*": ["./src/*"],
            "@sujin/lib/*": ["../@lib/src/*"],
            "@sujin/share/*": ["../@common/src/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "src/**/*.spec.ts"]
}
