{
    "ts-node": {
        "files": true
    },
    "files": ["src/server/index.ts", "src/global.d.ts"],
    "compilerOptions": {
        "target": "es2018",
        "module": "commonjs",
        "jsx": "react",
        "outDir": "./.build/development",
        "removeComments": true,
        "strict": true,
        "rootDirs": ["src"],
        "baseUrl": ".",
        "paths": {
            "@common/*": ["src/common/*"],
            "@constants/*": ["src/constants/*"],
            "@frontend/*": ["src/frontend/*"],
            "@server/*": ["src/server/*"],
            "@project/types/*": ["src/types/*"],
            "@utils/*": ["src/utils/*"]
        },
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["dom", "dom.iterable", "esnext"]
    },
    "include": ["src/**/*", ".configs/jest/fixture.ts"]
}
