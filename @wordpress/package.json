{
	"name": "sujin-wordpress",
	"version": "12.0.1-prod.1",
	"description": "Wordpress CMS for sujinc.com project",
	"author": "Sujin Choi",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "yarn --cwd ./plugins/carousel build && yarn --cwd ./plugins/resume-item build",
		"install-modules": "yarn --cwd ./plugins/resume-item && yarn --cwd ./plugins/carousel",
		"package": "node ./package.mjs"
	},
	"devDependencies": {
		"dotenv": "^17.2.3"
	},
	"prettier": {
		"arrowParens": "always",
		"bracketSpacing": true,
		"endOfLine": "lf",
		"printWidth": 120,
		"proseWrap": "preserve",
		"quoteProps": "as-needed",
		"tabWidth": 4,
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "all"
	}
}
