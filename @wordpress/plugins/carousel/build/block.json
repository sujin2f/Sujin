{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sujin/carousel",
  "version": "0.1.0",
  "title": "Carousel",
  "category": "media",
  "icon": "images-alt",
  "description": "",
  "supports": {
    "interactivity": true
  },
  "textdomain": "carousel",
  "attributes": {
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "attributes": {
          "id": {
            "type": "number"
          },
          "src": {
            "type": "string"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      },
      "default": []
    }
  },
  "editorScript": "file:./index.js",
  "render": "file:./render.php"
}