{
    "compilerOptions": {
        "target": "es2022",
        "module": "NodeNext",
        "moduleResolution": "node16",
        "lib": ["dom", "es2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "paths": {
            "@test/*": ["./.jest/*"],
            "@sujin/share/*": ["../@common/src/*"]
        },
        "types": ["jest"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "internal_modules"]
}
