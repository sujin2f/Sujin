{
    "name": "sujin",
    "version": "11.0.0",
    "description": "WordPress theme for sujinc.com",
    "license": "MIT",
    "main": ".build/production/server/index.js",
    "scripts": {
        "dev": "npm-run-all -s dev:clean dev:watch",
        "dev:clean": "rimraf .build/development/*",
        "dev:watch": "concurrently --kill-others-on-fail \"yarn dev:node\" \"yarn dev:react\"",
        "dev:node": "NODE_ENV=development ts-node-dev -r tsconfig-paths/register --respawn ./src/server/index.ts",
        "dev:react": "NODE_ENV=development webpack --watch --config .configs/webpack.config.babel.js",
        "prod": "npm-run-all -s prod:clean prod:tsc prod:webpack",
        "prod:clean": "rimraf .build/production/*",
        "prod:webpack": "NODE_ENV=production webpack --config .configs/webpack.config.babel.js",
        "prod:tsc": "NODE_ENV=production tsc --project .configs/tsconfig.production.server.json",
        "prod:server": "NODE_ENV=production node .build/production/server/index.js",
        "prod:analyze": "source-map-explorer '.build/production/frontend/*.js'",
        "test": "NODE_ENV=development jest --config=.configs/jest.config.json --rootDir=./",
        "lint": "eslint --fix ./src/**/*.ts ./src/**/*.tsx",
        "pretty": "yarn prettier --config .configs/prettier.json -w ./src ./public .configs ./*.yml ./*.js ./*.json"
    },
    "dependencies": {},
    "devDependencies": {
        "@babel/preset-react": "^7.26.3",
        "@babel/preset-typescript": "^7.26.0",
        "@babel/register": "^7.25.9",
        "@eslint/compat": "^1.2.4",
        "@eslint/js": "^9.17.0",
        "@svgr/webpack": "^8.1.0",
        "@tanstack/react-query": "^5.62.15",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/compression": "^1.7.5",
        "@types/ejs": "^3.1.1",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.2.3",
        "@types/module-alias": "^2.0.1",
        "@types/mongoose": "^5.11.97",
        "@types/mysql": "^2.15.21",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.2",
        "@types/react-color": "^3.0.6",
        "@types/react-dom": "^19.0.2",
        "@types/react-router-dom": "^5.3.3",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.19.0",
        "@typescript-eslint/parser": "^8.19.0",
        "axios": "^0.27.2",
        "babel-loader": "^9.2.1",
        "babel-plugin-import": "^1.13.8",
        "clean-webpack-plugin": "^4.0.0",
        "compression": "^1.7.4",
        "compression-webpack-plugin": "^11.1.0",
        "concurrently": "^9.1.2",
        "css-loader": "^7.1.2",
        "dotenv": "^16.0.3",
        "ejs": "^3.1.8",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react": "^7.37.3",
        "eslint-webpack-plugin": "^4.2.0",
        "express": "^4.18.1",
        "express-graphql": "^0.12.0",
        "graphql": "^16.6.0",
        "graphql-http": "^1.17.1",
        "http": "^0.0.1-security",
        "https": "^1.0.0",
        "jest": "^29.3.1",
        "jest-environment-jsdom": "^29.3.1",
        "mini-css-extract-plugin": "^2.9.2",
        "module-alias": "^2.2.2",
        "mongoose": "^8.9.3",
        "mysql": "^2.18.1",
        "node-cache": "^5.1.2",
        "npm-run-all": "^4.1.5",
        "optimize-css-assets-webpack-plugin": "^6.0.1",
        "path": "^0.12.7",
        "php-unserialize": "^0.0.1",
        "prettier": "^3.4.2",
        "promise-mysql": "^5.2.0",
        "react": "^19.0.0",
        "react-color": "^2.19.3",
        "react-dom": "^19.0.0",
        "react-refresh": "^0.16.0",
        "react-router-dom": "^7.1.1",
        "rimraf": "^6.0.1",
        "sass": "^1.81.0",
        "sass-loader": "^16.0.4",
        "source-map-explorer": "^2.5.3",
        "style-loader": "^4.0.0",
        "supertest": "^7.0.0",
        "terser-webpack-plugin": "^5.3.11",
        "ts-jest": "^29.0.3",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.1.0",
        "typescript": "5.7.2",
        "typescript-eslint": "^8.19.0",
        "webpack": "^5.97.1",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0",
        "webpack-manifest-plugin": "^5.0.0",
        "webpack-merge": "^6.0.1"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
